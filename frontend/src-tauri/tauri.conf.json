{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Self Evolving Skills",
  "version": "1.0.1",
  "identifier": "com.selfevolvingskills.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Self Evolving Skills",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "licenseFile": "../../LICENSE",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "headerImage": "icons/installer-header.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyRjM2NUI3RTNCNTI1QTYKUldTbUpiWGp0Mlh6VWpqRGR0UHJlVFFFaExVZDNpak1UNTRyQm5mMGR1QmVOSnA1T215OS81bnYK",
      "endpoints": [
        "https://github.com/xinbaizhe/SelfEvolvingSkills/releases/latest/download/latest.json"
      ]
    }
  }
}
